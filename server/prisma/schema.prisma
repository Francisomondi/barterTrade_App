generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  TRADED
  SOLD
  EXPIRED
  REMOVED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  CANCELLED
  EXPIRED
}

enum TradeStatus {
  PENDING
  AGREED
  VERIFICATION
  READY_FOR_HANDOVER
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum NotificationType {
  OFFER
  MATCH
  TRADE
  MESSAGE
  VERIFICATION
  DISPUTE
  SYSTEM
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentType {
  PROMOTION
  SUBSCRIPTION
  VERIFICATION
  PROTECTED_TRADE
  OTHER
}

enum PromotionType {
  FEATURED
  BOOST
  HOMEPAGE
}

enum PromotionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PromotionAnalyticsEventType {
  VIEW
  CLICK
}

model User {
  id              String     @id @default(uuid())
  name            String
  email           String     @unique
  password        String?
  phone           String?    @unique
  avatar          String?
  googleId        String?    @unique
  authProvider    String     @default("LOCAL")
  bio             String?
  location        String?
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  barterScore     Float      @default(0)
  completedTrades Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  listings        Listing[]
  sentOffers      Offer[]   @relation("SentOffers")
  receivedOffers  Offer[]   @relation("ReceivedOffers")
  tradesAsA       Trade[]   @relation("TraderA")
  tradesAsB       Trade[]   @relation("TraderB")
  ratingsGiven    Rating[]  @relation("RatingsGiven")
  ratingsReceived Rating[]  @relation("RatingsReceived")

  verifications       Verification[]
  disputes            Dispute[]
  messagesSent        Message[]            @relation("MessagesSent")
  messagesReceived    Message[]            @relation("MessagesReceived")
  notifications       Notification[]
  payments            Payment[]
  promotions          Promotion[]
  subscriptions       Subscription[]
  matches             Match[]
  tradeConfirmations  TradeConfirmation[]
  passwordResetTokens PasswordResetToken[]

  disputeEvents            DisputeEvent[]
  promotionAnalyticsEvents PromotionAnalyticsEvent[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())

  listings Listing[]
}

model Listing {
  id             String        @id @default(uuid())
  userId         String
  categoryId     String
  title          String
  description    String
  condition      ItemCondition
  estimatedValue Float
  minimumValue   Float?
  maximumValue   Float?
  location       String?
  latitude       Float?
  longitude      Float?
  status         ListingStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id])
  images         ListingImage[]
  valueEstimates ValueEstimate[]
  offersSent     Offer[]         @relation("OfferedListing")
  offersReceived Offer[]         @relation("RequestedListing")
  matchesAsA     Match[]         @relation("ListingA")
  matchesAsB     Match[]         @relation("ListingB")
  tradeItems     TradeItem[]
  promotions     Promotion[]
}

model ListingImage {
  id        String  @id @default(uuid())
  listingId String
  url       String
  publicId  String?

  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, sortOrder])
  @@index([listingId, isPrimary])
}

model ValueEstimate {
  id             String   @id @default(uuid())
  listingId      String
  estimatedValue Float
  confidence     Float?
  source         String?
  createdAt      DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Match {
  id            String   @id @default(uuid())
  userId        String
  listingAId    String
  listingBId    String
  score         Float
  valueScore    Float?
  locationScore Float?
  trustScore    Float?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingA Listing @relation("ListingA", fields: [listingAId], references: [id], onDelete: Cascade)
  listingB Listing @relation("ListingB", fields: [listingBId], references: [id], onDelete: Cascade)

  @@unique([listingAId, listingBId])
  @@index([userId])
  @@index([listingAId])
  @@index([listingBId])
  @@index([status])
  @@index([score])
}

model Offer {
  id                 String      @id @default(uuid())
  senderId           String
  receiverId         String
  offeredListingId   String
  requestedListingId String
  message            String?
  status             OfferStatus @default(PENDING)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  sender           User    @relation("SentOffers", fields: [senderId], references: [id], onDelete: Cascade)
  receiver         User    @relation("ReceivedOffers", fields: [receiverId], references: [id], onDelete: Cascade)
  offeredListing   Listing @relation("OfferedListing", fields: [offeredListingId], references: [id])
  requestedListing Listing @relation("RequestedListing", fields: [requestedListingId], references: [id])
  trade            Trade?
}

model Trade {
  id          String @id @default(uuid())
  tradeNumber String @unique
  offerId     String @unique

  traderAId String
  traderBId String

  status TradeStatus @default(PENDING)

  // Two-party confirmation
  traderAConfirmed Boolean @default(false)
  traderBConfirmed Boolean @default(false)

  // Confirmation timestamps
  traderAConfirmedAt DateTime?
  traderBConfirmedAt DateTime?

  agreedValueA Float?
  agreedValueB Float?

  handoverLocation String?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer Offer @relation(fields: [offerId], references: [id])

  traderA User @relation("TraderA", fields: [traderAId], references: [id])
  traderB User @relation("TraderB", fields: [traderBId], references: [id])

  confirmations TradeConfirmation[]

  items   TradeItem[]
  ratings Rating[]
  dispute Dispute?

  verifications Verification[]
  payments      Payment[]
}

model TradeItem {
  id          String @id @default(uuid())
  tradeId     String
  listingId   String
  ownerId     String
  agreedValue Float

  trade   Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])
}

model TradeConfirmation {
  id          String   @id @default(uuid())
  tradeId     String
  userId      String
  stage       String
  confirmedAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tradeId, userId, stage])
  @@index([tradeId])
  @@index([userId])
}

model Rating {
  id         String   @id @default(uuid())
  tradeId    String
  reviewerId String
  reviewedId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  trade    Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  reviewer User  @relation("RatingsGiven", fields: [reviewerId], references: [id])
  reviewed User  @relation("RatingsReceived", fields: [reviewedId], references: [id])

  @@unique([tradeId, reviewerId, reviewedId])
  @@index([tradeId])
  @@index([reviewedId])
}

model Verification {
  id          String             @id @default(uuid())
  userId      String
  tradeId     String
  type        String
  status      VerificationStatus @default(PENDING)
  documentUrl String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([userId])
}

model Dispute {
  id          String        @id @default(uuid())
  tradeId     String        @unique
  userId      String
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  previousTradeStatus TradeStatus?
  outcome             String?
  outcomeAt           DateTime?

  trade Trade @relation(fields: [tradeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  events DisputeEvent[]
}

model DisputeEvent {
  id          String   @id @default(uuid())
  disputeId   String
  userId      String?
  eventType   String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([disputeId])
  @@index([userId])
  @@index([createdAt])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Notification {
  id      String           @id @default(uuid())
  userId  String
  type    NotificationType
  title   String
  message String

  referenceId   String?
  referenceType String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, referenceId, referenceType])
}

model Payment {
  id String @id @default(uuid())

  userId      String
  tradeId     String?
  promotionId String?

  amount   Float
  currency String        @default("KES")
  status   PaymentStatus @default(PENDING)
  type     PaymentType

  provider    String  @default("MPESA")
  phoneNumber String?

  // M-Pesa identifiers
  merchantRequestId String?
  checkoutRequestId String?
  receiptNumber     String?

  // M-Pesa callback result
  resultCode        String?
  resultDescription String?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade     Trade?     @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tradeId])
  @@index([promotionId])
  @@index([status])
  @@index([type])
  @@index([checkoutRequestId])
  @@index([merchantRequestId])
}

model Promotion {
  id String @id @default(uuid())

  userId    String
  listingId String

  type   PromotionType
  status PromotionStatus @default(PENDING)

  amount   Float
  currency String @default("KES")

  durationDays Int

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  payments        Payment[]
  analyticsEvents PromotionAnalyticsEvent[]

  @@index([userId])
  @@index([listingId])
  @@index([status])
  @@index([type])
  @@index([endsAt])
  @@index([listingId, status])
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  plan      String
  status    String    @default("ACTIVE")
  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PromotionAnalyticsEvent {
  id String @id @default(uuid())

  promotionId String
  userId      String?

  type PromotionAnalyticsEventType

  createdAt DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([promotionId])
  @@index([promotionId, type])
  @@index([promotionId, createdAt])
  @@index([userId])
}
